{
  "productName": "TridentDroid",
  "version": "0.1.0",
  "identifier": "com.tridentd.gui",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TridentDroid",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },

  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "TridentDroid Android Emulator",
    "longDescription": "Production-grade cross-platform Android emulator with KVM/WHP acceleration"
  }
}
