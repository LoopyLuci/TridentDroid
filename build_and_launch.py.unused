import subprocess
import os
import sys
import time

def run(cmd, **kwargs):
    print(f"> {cmd}")
    result = subprocess.run(cmd, shell=True, capture_output=True, text=True, **kwargs)
    if result.stdout:
        print(result.stdout[-1000:] if len(result.stdout) > 1000 else result.stdout)
    if result.stderr:
        print(result.stderr[-1000:] if len(result.stderr) > 1000 else result.stderr)
    return result.returncode

# Step 1: Build the project (without broken build.rs)
print("=== Step 1: Building TridentDroid GUI ===")
rc = run("cd Z:/Projects/TridentDroidEmulator/tauri-gui && cargo build --release")
if rc != 0:
    print("Build failed!")
    sys.exit(1)

# Step 2: Embed the Common Controls v6 manifest
print("\n=== Step 2: Embedding manifest ===")
exe_path = "Z:/Projects/TridentDroidEmulator/target/release/tridentd-gui.exe"
manifest_path = "Z:/Projects/TridentDroidEmulator/tauri-gui/src-tauri/app.manifest"
mt_exe = "C:/Program Files (x86)/Windows Kits/10/bin/10.0.19041.0/x64/mt.exe"

# First verify the manifest file exists
if not os.path.exists(manifest_path):
    print(f"ERROR: Manifest file not found: {manifest_path}")
    sys.exit(1)

# Embed the manifest
rc = run(f'"{mt_exe}" -nologo -manifest "{manifest_path}" -outputresource:"{exe_path}"')
if rc != 0:
    print("Manifest embedding failed!")
    sys.exit(1)

# Step 3: Verify the manifest was embedded
print("\n=== Step 3: Verifying manifest ===")
verify_path = "Z:/temp_manifest.xml"
rc = run(f'"{mt_exe}" -nologo -inputresource:"{exe_path}" -out:{verify_path}')
if rc == 0 and os.path.exists(verify_path):
    with open(verify_path) as f:
        content = f.read()
    if "Common-Controls" in content:
        print("✓ Manifest verified successfully!")
    else:
        print("⚠ Manifest content unexpected:")
        print(content[:500])
else:
    print("⚠ Could not verify manifest (this may be ok)")

# Step 4: Launch the application
print("\n=== Step 4: Launching TridentDroid GUI ===")
# Use DETACHED_PROCESS so the app survives
rc = run(f'start "" "{exe_path}"')
print(f"Launch command returned: {rc}")

# Wait a moment and check if process is running
time.sleep(3)
rc = run('powershell.exe -Command "Get-Process -Name tridentd-gui -ErrorAction SilentlyContinue | Format-List Id, ProcessName, StartTime"')
print(f"Process check returned: {rc}")
